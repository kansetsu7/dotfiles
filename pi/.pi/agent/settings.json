{
  "lastChangelogVersion": "0.87.0",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5",
  "defaultThinkingLevel": "high",
  "theme": "dark",
  "enableSkillCommands": true,
  "tuiMode": "fullscreen",
  "packages": [
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:pi-web-access",
    "npm:pi-vim"
